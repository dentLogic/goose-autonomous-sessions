+// goose-autonomous-sessions: IPC bridge
+const AUTONOMOUS_STATE_FILE = path.join(app.getPath('userData'), 'autonomous-state.json');
+const AUTONOMOUS_SETTINGS_FILE = path.join(app.getPath('userData'), 'autonomous-settings.json');
+
+ipcMain.handle('autonomous:get-state', async () => {
+  try {
+    const raw = await fs.readFile(AUTONOMOUS_STATE_FILE, 'utf8');
+    return JSON.parse(raw);
+  } catch {
+    return null;
+  }
+});
+
+ipcMain.handle('autonomous:set-state', async (_event, state: unknown) => {
+  await fs.writeFile(AUTONOMOUS_STATE_FILE, JSON.stringify(state, null, 2));
+});
+
+ipcMain.handle('autonomous:clear-state', async () => {
+  try {
+    await fs.unlink(AUTONOMOUS_STATE_FILE);
+  } catch {
+  }
+});
+
+ipcMain.handle('autonomous:get-settings', async () => {
+  try {
+    const raw = await fs.readFile(AUTONOMOUS_SETTINGS_FILE, 'utf8');
+    return JSON.parse(raw);
+  } catch {
+    return { enabled: false, rolloverThreshold: 0.75 };
+  }
+});
+
+ipcMain.handle('autonomous:set-settings', async (_event, settings: unknown) => {
+  await fs.writeFile(AUTONOMOUS_SETTINGS_FILE, JSON.stringify(settings, null, 2));
+});
+
+// goose-autonomous-sessions: auto-create settings + state on startup
+// This ensures the dashboard has data to show without manual file creation.
+async function initAutonomousController() {
+  try {
+    // 1. Create default settings file if it doesn't exist
+    let settings;
+    try {
+      const raw = await fs.readFile(AUTONOMOUS_SETTINGS_FILE, 'utf8');
+      settings = JSON.parse(raw);
+    } catch {
+      // File doesn't exist — create with defaults
+      settings = { enabled: false, rolloverThreshold: 0.75 };
+      await fs.writeFile(AUTONOMOUS_SETTINGS_FILE, JSON.stringify(settings, null, 2));
+      console.log('[autonomous] created default settings file');
+    }
+
+    // 2. Create a default run state if enabled and no run exists
+    if (settings.enabled) {
+      let runState = null;
+      try {
+        const raw = await fs.readFile(AUTONOMOUS_STATE_FILE, 'utf8');
+        runState = JSON.parse(raw);
+      } catch {
+        // No state file — create one
+      }
+
+      if (!runState) {
+        const now = new Date().toISOString();
+        runState = {
+          schemaVersion: 1,
+          runId: 'auto-' + Date.now(),
+          status: 'active',
+          phase: 'working',
+          originalObjective: 'Autonomous session active',
+          currentSessionId: 'auto-session',
+          rolloverPending: false,
+          contextUsage: 0,
+          contextLimit: 200000,
+          rolloverThreshold: settings.rolloverThreshold || 0.75,
+          workerGeneration: 1,
+          verificationAttempt: 0,
+          createdAt: now,
+          updatedAt: now,
+        };
+        await fs.writeFile(AUTONOMOUS_STATE_FILE, JSON.stringify(runState, null, 2));
+        console.log('[autonomous] created initial run state — run started');
+      }
+
+      // 3. Initialize the controller with electron adapters
+      const { initController } = await import('./autonomous');
+      const { electronStateStore } = await import('./adapters/electron-state-store');
+      const { electronLogger } = await import('./adapters/electron-logger');
+      const { acpHandoffGenerator, acpSendPrompt } = await import('./adapters/acp-integration');
+      initController({
+        store: electronStateStore,
+        logger: electronLogger,
+        generateHandoffResponse: acpHandoffGenerator,
+        sendPrompt: acpSendPrompt,
+      });
+      console.log('[autonomous] controller initialized — autonomous mode ON');
+    } else {
+      console.log('[autonomous] controller initialized — autonomous mode OFF (enable in settings)');
+    }
+  } catch (e) {
+    console.error('[autonomous] failed to initialize:', e);
+  }
+}
+
