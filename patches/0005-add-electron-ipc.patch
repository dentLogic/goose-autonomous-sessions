+// goose-autonomous-sessions: IPC bridge + controller
+const AUTONOMOUS_STATE_FILE = path.join(app.getPath('userData'), 'autonomous-state.json');
+const AUTONOMOUS_SETTINGS_FILE = path.join(app.getPath('userData'), 'autonomous-settings.json');
+
+// State file read/write helpers
+async function readJson(file: string, fallback: any): Promise<any> {
+  try {
+    const raw = await fs.readFile(file, 'utf8');
+    return JSON.parse(raw);
+  } catch {
+    return fallback;
+  }
+}
+async function writeJson(file: string, data: any): Promise<void> {
+  await fs.writeFile(file, JSON.stringify(data, null, 2));
+}
+
+// IPC: state get/set/clear
+ipcMain.handle('autonomous:get-state', async () => readJson(AUTONOMOUS_STATE_FILE, null));
+ipcMain.handle('autonomous:set-state', async (_e, state: unknown) => writeJson(AUTONOMOUS_STATE_FILE, state));
+ipcMain.handle('autonomous:clear-state', async () => {
+  try { await fs.unlink(AUTONOMOUS_STATE_FILE); } catch {}
+});
+
+// IPC: settings get/set
+ipcMain.handle('autonomous:get-settings', async () => readJson(AUTONOMOUS_SETTINGS_FILE, { enabled: false, rolloverThreshold: 0.75 }));
+ipcMain.handle('autonomous:set-settings', async (_e, settings: unknown) => writeJson(AUTONOMOUS_SETTINGS_FILE, settings));
+
+// IPC: sessions
+ipcMain.handle('autonomous:get-sessions', async () => {
+  try {
+    const sessionsFile = path.join(app.getPath('userData'), 'autonomous-sessions.json');
+    const data = await readJson(sessionsFile, { sessions: [] });
+    return data.sessions || [];
+  } catch {
+    return [];
+  }
+});
+
+// IPC: logs
+ipcMain.handle('autonomous:get-logs', async (_e, limit?: number, runId?: string) => {
+  try {
+    const logsFile = path.join(app.getPath('userData'), 'autonomous.log.jsonl');
+    const data = await readJson(logsFile, { logs: [] });
+    let logs = data.logs || [];
+    if (runId) logs = logs.filter((l: any) => l.runId === runId);
+    return logs.slice(-(limit || 200)).reverse();
+  } catch {
+    return [];
+  }
+});
+
+// Controller reference (initialized in initAutonomousController)
+let _controller: any = null;
+
+async function initAutonomousController() {
+  try {
+    // 1. Create default settings if missing
+    let settings = await readJson(AUTONOMOUS_SETTINGS_FILE, null);
+    if (!settings) {
+      settings = { enabled: false, rolloverThreshold: 0.75 };
+      await writeJson(AUTONOMOUS_SETTINGS_FILE, settings);
+      console.log('[autonomous] created default settings file');
+    }
+
+    // 2. Initialize the controller with electron adapters
+    const { initController } = await import('./autonomous');
+    const { electronStateStore } = await import('./adapters/electron-state-store');
+    const { electronLogger } = await import('./adapters/electron-logger');
+    const { acpHandoffGenerator, acpSendPrompt } = await import('./adapters/acp-integration');
+    _controller = initController({
+      store: electronStateStore,
+      logger: electronLogger,
+      generateHandoffResponse: acpHandoffGenerator,
+      sendPrompt: acpSendPrompt,
+    });
+
+    if (settings.enabled) {
+      console.log('[autonomous] controller initialized — autonomous mode ON');
+
+      // 3. If no run exists, create one
+      const existingRun = await readJson(AUTONOMOUS_STATE_FILE, null);
+      if (!existingRun && _controller) {
+        try {
+          await _controller.startRun({
+            sessionId: 'auto-' + Date.now(),
+            objective: 'Autonomous session active',
+            settings,
+          });
+          console.log('[autonomous] auto-started run');
+        } catch (e) {
+          console.error('[autonomous] failed to auto-start run:', e);
+        }
+      }
+    } else {
+      console.log('[autonomous] controller initialized — autonomous mode OFF');
+    }
+  } catch (e) {
+    console.error('[autonomous] failed to initialize:', e);
+  }
+}
+
+// IPC bridge: renderer → main process controller
+// These let the renderer call the real controller in the main process.
+ipcMain.handle('autonomous:start-run', async (_e, sessionId: string, objective: string) => {
+  if (!_controller) return null;
+  const settings = await readJson(AUTONOMOUS_SETTINGS_FILE, { enabled: false, rolloverThreshold: 0.75 });
+  return _controller.startRun({ sessionId, objective, settings });
+});
+
+ipcMain.handle('autonomous:on-context-usage', async (_e, sessionId: string, used: number, limit: number) => {
+  if (!_controller) return null;
+  return _controller.onContextUsage(sessionId, used, limit);
+});
+
+ipcMain.handle('autonomous:on-turn-finished', async (_e, sessionId: string, lastText: string, turn: any) => {
+  if (!_controller) return null;
+  return _controller.onTurnFinished(sessionId, lastText, turn);
+});
+
+ipcMain.handle('autonomous:stop-run', async () => {
+  if (!_controller) return null;
+  return _controller.stopRun();
+});
+
+ipcMain.handle('autonomous:resume-run', async () => {
+  if (!_controller) return null;
+  return _controller.resumeRun();
+});
+
+ipcMain.handle('autonomous:get-state-live', async () => {
+  if (!_controller) return null;
+  return _controller.getState();
+});
+
+
+
 ipcMain.handle('get-secret-key', (event) => {
